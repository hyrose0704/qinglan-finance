{
  "name": "qinglan-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "update-market": "node --experimental-strip-types scripts/update-market.mjs",
    "update-policy": "node --experimental-strip-types scripts/update-policy.mjs",
    "local-assistant": "node --use-system-ca --use-env-proxy --experimental-strip-types local-assistant/server.mjs"
  },
  "dependencies": {
    "jose": "6.2.18",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
